# Local Ollama instance — no API key needed, this all runs on lab hardware.
# Leave as-is if Ollama runs on the same machine as this backend.
OLLAMA_URL=http://localhost:11434

# Which model Ollama should use. Must be pulled first: `ollama pull qwen2.5:14b-instruct`
# See README for picking a model size that fits your GPU's VRAM.
OLLAMA_MODEL=qwen2.5:14b-instruct

# Comma-separated list of origins allowed to call this API.
# For local dev this is your Vite dev server; for production, your
# GitHub Pages URL, e.g. https://yourname.github.io
ALLOWED_ORIGINS=http://localhost:5173,https://yourname.github.io

PORT=4000
